# Frontend Application Environment Configuration Template
# Production settings:
# VITE_CUSTOMER_URL=https://www.example.com
# VITE_ADMIN_URL=https://admin.example.com
# VITE_GRAPHQL_URL=https://api.example.com/graphql
# VITE_API_BASE_URL=https://api.example.com

# Local development settings:
VITE_CUSTOMER_URL=http://localhost:4000
VITE_ADMIN_URL=http://localhost:4001
VITE_GRAPHQL_URL=http://localhost:8000/graphql
VITE_API_BASE_URL=http://localhost:8000

# Development Server Ports (Optional overrides)
VITE_CUSTOMER_PORT=4000
VITE_ADMIN_PORT=4001

# Explicit entry mode override (optional: 'customer', 'admin', or omit for auto-detect by URL/host/port)
# VITE_APP_MODE=customer
